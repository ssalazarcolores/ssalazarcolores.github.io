---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";

const pubsAll = (await getCollection("publications")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const talksAll = (await getCollection("talks")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const projectsAll = await getCollection("projects");
const teachingAll = (await getCollection("teaching")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const pubsByYear = pubsAll.reduce((acc, p) => {
  const y = p.data.date.getUTCFullYear();
  (acc[y] ||= []).push(p);
  return acc;
}, {} as Record<number, typeof pubsAll>);
const years = Object.keys(pubsByYear).map(Number).sort((a, b) => b - a);

// Always link to *something* — prefer the paper URL, fall back to a Google Scholar search
function paperLink(p: { data: { title: string; paperurl?: string } }) {
  return p.data.paperurl ?? `https://scholar.google.com/scholar?q=${encodeURIComponent(p.data.title)}`;
}

const selectedPubs = pubsAll.slice(0, 6);

const students = [
  { name: "Daniel A. Gutiérrez Jiménez", institution: "Maestría, CIO", year: "2024", topic: "Análisis no invasivo de flujos en reactores químicos industriales mediante aprendizaje profundo.", thesis: "https://cio.repositorioinstitucional.mx/jspui/handle/1002/1342" },
  { name: "Juan M. Chávez Medina", institution: "Maestría, CIO", year: "2023", topic: "Detección de carcinoma ductal invasivo (CDI) vía imágenes histopatológicas.", thesis: "https://cio.repositorioinstitucional.mx/jspui/handle/1002/1286" },
  { name: "Enrique Mena Camilo", institution: "Maestría, UAQ", year: "2024", topic: "Ensamble de modelos de aprendizaje profundo para clasificación de riesgo de coledocolitiasis.", thesis: "https://ri-ng.uaq.mx/handle/123456789/11247" },
  { name: "Sheila Leyva López", institution: "Maestría, UAQ", year: "2023", topic: "Predicción del daño pulmonar ocasionado por fibrosis pulmonar idiopática.", thesis: null },
  { name: "Gerardo Hernández Nava", institution: "Maestría, UAQ", year: "2023", topic: "Predicción de eventos epilépticos mediante técnicas de aprendizaje profundo.", thesis: "https://ri-ng.uaq.mx/handle/123456789/9749" },
  { name: "José H. León Chávez", institution: "Maestría, UAQ", year: "2021", topic: "Odometría y mapeo de lugares de difícil acceso mediante técnicas SLAM.", thesis: "https://ri-ng.uaq.mx/handle/123456789/3336" },
  { name: "Yamanki Santander Cruz", institution: "Maestría, UAQ", year: "2021", topic: "Detección de indicadores cognitivos de demencia temprana.", thesis: "https://ri-ng.uaq.mx/handle/123456789/3805" },
  { name: "Alexa F. Gutiérrez Medrano", institution: "Licenciatura, UPB", year: "2021", topic: "Detección de COVID-19 mediante imágenes de rayos X y aprendizaje profundo.", thesis: null },
  { name: "Tania J. Mendoza Torres", institution: "Licenciatura, UPB", year: "2021", topic: "Detección de melanomas vía redes neuronales convolucionales.", thesis: null },
];

const awards = [
  { year: "2023", text: "Co-Chair, 21° Congreso Nacional de Mecatrónica" },
  { year: "2019", text: "Premio al mejor trabajo de estudiante, MICAI" },
];
---

<Base>
  <Nav />

  <Hero />

  <main class="container-prose pb-32">
    <!-- ABOUT (longer bio paragraph in editorial voice) -->
    <section id="about" class="mt-12">
      <p class="text-base md:text-lg leading-relaxed prose-justify" style="color: var(--c-fg-soft);">
        Mi trabajo cruza tres dominios donde el aprendizaje profundo todavía falla con imágenes reales:
        el <strong style="color: var(--c-fg);">quirófano</strong> (laparoscopía obstruida por humo,
        detección de cáncer), el <strong style="color: var(--c-fg);">campo</strong> (diagnóstico
        nutricional de cultivos, calidad post-cosecha) y la <strong style="color: var(--c-fg);">clínica</strong>
        (predicción no invasiva de hernia incisional, coledocolitiasis, epilepsia vía EEG).
      </p>
      <p class="mt-4 text-base md:text-lg leading-relaxed prose-justify" style="color: var(--c-fg-soft);">
        Llevo ocho años publicando una línea sostenida sobre restauración de imagen
        — <em>dehazing</em>, <em>desmoking</em>, <em>sky detection</em> — que empezó como tesis
        doctoral y terminó traduciéndose a video laparoscópico en tiempo real con cirujanos.
        Soy profesor invitado en el Doctorado en Ingeniería de la UG y la Maestría en IA de la UAQ;
        he graduado <a href="#students" style="color: var(--c-fg-soft); border-bottom: 1px dotted var(--c-fg-muted);">9 estudiantes</a>
        y publico el código de los métodos que puedo abrir.
      </p>
    </section>

    <!-- SELECTED WORK -->
    <section id="work">
      <h2 class="section-label">selected work · {selectedPubs.length} of {pubsAll.length}</h2>
      <div>
        {selectedPubs.map((p) => (
          <article class="paper-row">
            <div class="year">{p.data.date.getUTCFullYear()}</div>
            <div class="body">
              <div class="title">
                <a href={paperLink(p)} target="_blank" rel="noopener" style="color: var(--c-fg); border-bottom: none;">
                  {p.data.title}
                </a>
              </div>
              <div class="meta">
                <em>{p.data.venue}</em>
                <span class="ml-2 mono text-xs" style="color: var(--c-fg-muted);">
                  {p.data.paperurl ? (
                    <a href={p.data.paperurl} target="_blank" rel="noopener" style="color: var(--c-accent); border-bottom: none;">pdf</a>
                  ) : (
                    <a href={paperLink(p)} target="_blank" rel="noopener" style="color: var(--c-fg-muted); border-bottom: none;">scholar</a>
                  )}
                  {p.data.github && (
                    <>
                      <span style="color: var(--c-border);"> · </span>
                      <a href={p.data.github} target="_blank" rel="noopener" style="color: var(--c-accent); border-bottom: none;">code</a>
                    </>
                  )}
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-3">
        <a href="#all-publications" class="link-accent">↓ ver las {pubsAll.length}</a>
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects">
      <h2 class="section-label">projects · prototypes</h2>
      <div class="grid sm:grid-cols-2 gap-x-6 gap-y-1">
        {projectsAll.map((proj) => {
          const videoMatch = proj.body?.match(/\((https:\/\/(?:www\.youtube\.com|youtu\.be)[^\s)]+)\)/);
          const video = videoMatch ? videoMatch[1] : undefined;
          const primary = video ?? proj.data.github;
          return (
            <article class="paper-row" style="grid-template-columns: 1fr;">
              <div class="body">
                <div class="title">
                  {primary ? (
                    <a href={primary} target="_blank" rel="noopener" style="color: var(--c-fg); border-bottom: none;">
                      {proj.data.title}
                      {video && <span class="mono text-xs ml-1" style="color: var(--c-accent);">▶</span>}
                    </a>
                  ) : (
                    <span>{proj.data.title}</span>
                  )}
                </div>
                <div class="meta">
                  {proj.data.excerpt}
                  {(video || proj.data.github) && (
                    <span class="ml-2 mono" style="font-size: 0.72rem;">
                      {video && (
                        <a href={video} target="_blank" rel="noopener" style="color: var(--c-accent); border-bottom: none;">video</a>
                      )}
                      {video && proj.data.github && <span style="color: var(--c-border);"> · </span>}
                      {proj.data.github && (
                        <a href={proj.data.github} target="_blank" rel="noopener" style="color: var(--c-accent); border-bottom: none;">code</a>
                      )}
                    </span>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- ALL PUBLICATIONS -->
    <section id="all-publications">
      <h2 class="section-label">publications · {pubsAll.length} total</h2>
      {years.map((y) => (
        <div class="mb-6">
          <div class="mono text-xs mb-1 mt-4" style="color: var(--c-fg-muted);">{y}</div>
          {pubsByYear[y].map((p) => (
            <article class="paper-row">
              <div class="year"></div>
              <div class="body">
                <div class="title" style="font-size: 0.95rem;">
                  <a href={paperLink(p)} target="_blank" rel="noopener" style="color: var(--c-fg); border-bottom: none;">
                    {p.data.title}
                  </a>
                </div>
                <div class="meta" style="font-size: 0.82rem;">
                  <em>{p.data.venue}</em>
                  <span class="ml-2 mono" style="font-size: 0.7rem; color: var(--c-fg-muted);">
                    {p.data.paperurl ? (
                      <a href={p.data.paperurl} target="_blank" rel="noopener" style="color: var(--c-accent); border-bottom: none;">pdf</a>
                    ) : (
                      <a href={paperLink(p)} target="_blank" rel="noopener" style="color: var(--c-fg-muted); border-bottom: none;">scholar</a>
                    )}
                    {p.data.github && (
                      <>
                        <span style="color: var(--c-border);"> · </span>
                        <a href={p.data.github} target="_blank" rel="noopener" style="color: var(--c-accent); border-bottom: none;">code</a>
                      </>
                    )}
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}
    </section>

    <!-- TALKS -->
    <section id="talks">
      <h2 class="section-label">talks · {talksAll.length}</h2>
      {talksAll.map((t) => (
        <article class="paper-row">
          <div class="year">{t.data.date.getUTCFullYear()}</div>
          <div class="body">
            <div class="title" style="font-size: 0.95rem;">
              {t.data.url ? (
                <a href={t.data.url} target="_blank" rel="noopener" style="color: var(--c-fg); border-bottom: none;">{t.data.title}</a>
              ) : (
                <span>{t.data.title}</span>
              )}
            </div>
            <div class="meta" style="font-size: 0.82rem;">
              <em>{t.data.venue}</em>
              {t.data.location && (
                <>
                  <span style="color: var(--c-border);"> · </span>
                  <span>{t.data.location}</span>
                </>
              )}
              {t.data.url && (
                <span class="ml-2 mono" style="font-size: 0.7rem;">
                  <a href={t.data.url} target="_blank" rel="noopener" style="color: var(--c-accent); border-bottom: none;">memoria</a>
                </span>
              )}
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- TEACHING -->
    <section id="teaching">
      <h2 class="section-label">teaching</h2>
      {teachingAll.map((t) => (
        <article class="paper-row">
          <div class="year">{t.data.date.getUTCFullYear()}</div>
          <div class="body">
            <div class="title">{t.data.title}</div>
            <div class="meta">
              <em>{t.data.venue}</em>
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- STUDENTS -->
    <section id="students">
      <h2 class="section-label">graduated students · {students.length}</h2>
      {students.map((s) => (
        <article class="paper-row">
          <div class="year">{s.year}</div>
          <div class="body">
            <div class="title" style="font-size: 0.95rem;">
              {s.thesis ? (
                <a href={s.thesis} target="_blank" rel="noopener" style="color: var(--c-fg); border-bottom: none;">{s.name}</a>
              ) : (
                <span>{s.name}</span>
              )}
            </div>
            <div class="meta" style="font-size: 0.85rem;">
              <em>{s.institution}</em> <span style="color: var(--c-border);">·</span> {s.topic}
              {s.thesis && (
                <span class="ml-1 mono" style="font-size: 0.72rem;">
                  <a href={s.thesis} target="_blank" rel="noopener" style="color: var(--c-accent); border-bottom: none;">tesis</a>
                </span>
              )}
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- AWARDS -->
    <section id="awards">
      <h2 class="section-label">awards</h2>
      {awards.map((a) => (
        <article class="paper-row">
          <div class="year">{a.year}</div>
          <div class="body">
            <div class="title">{a.text}</div>
          </div>
        </article>
      ))}
    </section>

    <!-- CONTACT -->
    <section id="contact" class="mt-16">
      <h2 class="section-label">contact</h2>
      <p class="text-base leading-relaxed mt-2" style="color: var(--c-fg-soft);">
        Si te interesa colaborar en proyectos de IA aplicada a imagen médica,
        agricultura de precisión o procesamiento de señales biomédicas, escríbeme.
        Recibo solicitudes de estudiantes de posgrado interesados en estos temas.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href="mailto:sebastian.salazar@cio.mx" class="btn-mono" style="border-bottom: none;">sebastian.salazar@cio.mx</a>
        <a href="https://scholar.google.com.mx/citations?user=WQcH3sEAAAAJ" target="_blank" rel="noopener" class="btn-mono" style="border-bottom: none;">scholar</a>
        <a href="https://orcid.org/0000-0002-6353-0864" target="_blank" rel="noopener" class="btn-mono" style="border-bottom: none;">orcid</a>
        <a href="https://github.com/ssalazarcolores" target="_blank" rel="noopener" class="btn-mono" style="border-bottom: none;">github</a>
      </div>
    </section>

    <footer class="mt-24 pt-8 mono text-xs" style="color: var(--c-fg-muted); border-top: 1px solid var(--c-border);">
      <div class="flex justify-between flex-wrap gap-2">
        <span>© {new Date().getFullYear()} Sebastián Salazar-Colores</span>
        <span>built with astro · <a href="https://github.com/ssalazarcolores/ssalazarcolores.github.io" style="color: var(--c-fg-muted); border-bottom: none;" target="_blank" rel="noopener">source</a></span>
      </div>
    </footer>
  </main>
</Base>
