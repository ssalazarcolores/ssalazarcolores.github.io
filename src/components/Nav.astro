---
const links = [
  { href: "/#work", label: "work" },
  { href: "/#projects", label: "projects" },
  { href: "/#talks", label: "talks" },
  { href: "/#teaching", label: "teaching" },
  { href: "/#contact", label: "contact" },
];
---

<header class="sticky top-0 z-50 backdrop-blur" style="background: color-mix(in srgb, var(--c-bg) 85%, transparent); border-bottom: 1px solid var(--c-border);">
  <div class="container-prose flex items-center justify-between h-12">
    <a href="/" class="mono text-sm font-medium" style="color: var(--c-fg); border-bottom: none;">
      ssc<span style="color: var(--c-accent);">.</span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2">
      {links.map((l) => (
        <a
          href={l.href}
          class="mono text-xs px-2 py-1 hidden sm:inline-block"
          style="color: var(--c-fg-muted); border-bottom: none;"
        >
          {l.label}
        </a>
      ))}

      <button
        type="button"
        aria-label="Toggle theme"
        class="mono text-xs px-2 py-1"
        style="color: var(--c-fg-muted); background: transparent; border: 1px solid var(--c-border); border-radius: 999px; cursor: pointer; margin-left: 0.25rem;"
        onclick="toggleTheme()"
      >
        <span id="theme-icon">◐</span>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  // After hydration, update the toggle icon to match current theme
  (function () {
    var icon = document.getElementById("theme-icon");
    if (icon && document.documentElement.getAttribute("data-theme") === "dark") icon.textContent = "☀";
  })();
</script>
